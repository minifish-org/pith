{
  "batch": "tools-edit",
  "id": "crlf",
  "input": {
    "op": "tool",
    "file": "packages/agent/src/harness/tools/edit.ts",
    "fn": "createEditTool",
    "text": "a\r\nb\r\n",
    "args": {
      "path": "file.txt",
      "oldText": "b",
      "newText": "B"
    },
    "inspect": "file.txt"
  },
  "expected": {
    "ok": true,
    "value": {
      "result": {
        "content": [
          {
            "type": "text",
            "text": "Successfully replaced 1 block(s) in file.txt."
          }
        ],
        "details": {
          "diff": " 1 a\n-2 b\n+2 B",
          "patch": "--- file.txt\n+++ file.txt\n@@ -1,2 +1,2 @@\n a\n-b\n+B\n",
          "firstChangedLine": 2
        }
      },
      "after": "a\r\nB\r\n"
    }
  }
}
