{
  "batch": "tools-edit",
  "id": "unicode",
  "input": {
    "op": "tool",
    "file": "packages/agent/src/harness/tools/edit.ts",
    "fn": "createEditTool",
    "text": "你好世界",
    "args": {
      "path": "file.txt",
      "oldText": "世界",
      "newText": "Pi"
    },
    "inspect": "file.txt"
  },
  "expected": {
    "ok": true,
    "value": {
      "result": {
        "content": [
          {
            "type": "text",
            "text": "Successfully replaced 1 block(s) in file.txt."
          }
        ],
        "details": {
          "diff": "-1 你好世界\n+1 你好Pi",
          "patch": "--- file.txt\n+++ file.txt\n@@ -1,1 +1,1 @@\n-你好世界\n\\ No newline at end of file\n+你好Pi\n\\ No newline at end of file\n",
          "firstChangedLine": 1
        }
      },
      "after": "你好Pi"
    }
  }
}
